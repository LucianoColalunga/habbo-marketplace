# Copiá este archivo como .env.local y completá lo que uses. Todo es opcional en local.

# Hoteles que muestra y escanea la web (el primero es el de inicio).
# Códigos: es, com, br, de, fr, it, nl, fi, tr
NEXT_PUBLIC_HOTELS=es,com,br

# Almacenamiento: sin token se usa la carpeta local .data/ (DATA_DIR para cambiarla).
# En Vercel, al conectar un Blob store se crea BLOB_READ_WRITE_TOKEN solo.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
# DATA_DIR=.data

# Secreto para las rutas /api/cron/* (Vercel lo manda solo en sus cron jobs).
# Generalo con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=

# Ritmo del recolector (por defecto 1 pedido cada 5000 ms) y tiempo máximo por corrida.
# SCAN_INTERVAL_MS=5000
# SCAN_TIME_BUDGET_MS=240000
# SCAN_MIN_INTERVAL_MINUTES=10

# URL pública del sitio, para los enlaces de los avisos, la dirección canónica, el sitemap
# y la vista previa al compartir. En Vercel no hace falta: se usa el dominio de producción.
# SITE_URL=https://tu-proyecto.vercel.app

# Código de verificación de Google Search Console (opcional, es público). Es el valor de
# content="..." de la etiqueta <meta name="google-site-verification">.
# GOOGLE_SITE_VERIFICATION=

# Alertas del servidor (opcional). Pegá acá el JSON que exporta la página /alertas.
# ALERTS_RULES=[{"id":"abc","hotel":"es","item":"throne","mode":"below_avg","value":20}]
# Ofertas que se publican en los canales: % por debajo de lo pagado esa semana (por defecto 30; 0 = no publicar).
# ALERTS_DEALS_MIN_DISCOUNT=30

# Botones "Unite" que ven los visitantes (enlaces públicos de invitación).
# NEXT_PUBLIC_DISCORD_URL=https://discord.gg/xxxx
# NEXT_PUBLIC_TELEGRAM_URL=https://t.me/TuCanal
# NEXT_PUBLIC_WHATSAPP_URL=https://whatsapp.com/channel/xxxx

# Cuentas (opcional). La integración gratuita de Upstash for Redis en Vercel agrega estas dos solas:
# KV_REST_API_URL=https://xxxx.upstash.io
# KV_REST_API_TOKEN=
# Clave para firmar las sesiones (opcional, 32+ caracteres; si falta se deriva del token).
# SESSION_SECRET=
# Solo en tu PC, para probar cuentas sin base de datos (guarda en .data/accounts-dev.json y los
# correos en .data/mail-outbox.json):
# ACCOUNTS_DEV_STORE=1

# Correos de la cuenta (confirmar el email y recuperar la cuenta), por SMTP.
# Con Gmail: una cuenta solo para el sitio, verificación en dos pasos y una "contraseña de aplicación".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=
# MAIL_FROM="Stats <tucuenta@gmail.com>"

# Panel de administración (/admin): usuarios separados por coma. Creá la cuenta antes de ponerla acá.
# ADMIN_USERS=tuusuario

# Canal Discord: URL del webhook del canal.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Canal Telegram: token de tu bot (de @BotFather) y el canal donde publica (ej. @TuCanal; el bot tiene que ser admin).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Mostrar o no las imágenes de los furnis (on/off).
# NEXT_PUBLIC_FURNI_IMAGES=on
