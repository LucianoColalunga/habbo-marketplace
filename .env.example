# Copiá este archivo como .env.local y completá lo que uses. Todo es opcional en local.

# Hoteles que muestra y escanea la web (el primero es el de inicio).
# Códigos: es, com, br, de, fr, it, nl, fi, tr
NEXT_PUBLIC_HOTELS=es,com,br

# Almacenamiento: sin token se usa la carpeta local .data/ (DATA_DIR para cambiarla).
# En Vercel, al conectar un Blob store se crea BLOB_READ_WRITE_TOKEN solo.
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
# DATA_DIR=.data

# Secreto para las rutas /api/cron/* (Vercel lo manda solo en sus cron jobs).
# Generalo con: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# CRON_SECRET=

# Ritmo del recolector (por defecto 1 pedido cada 5000 ms) y tiempo máximo por corrida.
# SCAN_INTERVAL_MS=5000
# SCAN_TIME_BUDGET_MS=240000
# SCAN_MIN_INTERVAL_MINUTES=10

# URL pública del sitio, para los enlaces de los avisos.
# SITE_URL=https://tu-proyecto.vercel.app

# Alertas del servidor (opcional). Pegá acá el JSON que exporta la página /alertas.
# ALERTS_RULES=[{"id":"abc","hotel":"es","item":"throne","mode":"below_avg","value":20}]
# Avisar también de ofertas generales muy fuertes (% por debajo del promedio, ej. 40).
# ALERTS_DEALS_MIN_DISCOUNT=40

# Canal Discord: URL del webhook del canal.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# Canal Telegram: token de tu bot (de @BotFather) y el chat_id donde avisar.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Mostrar o no las imágenes de los furnis (on/off).
# NEXT_PUBLIC_FURNI_IMAGES=on
